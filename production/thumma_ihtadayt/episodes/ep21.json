  {
   "id": "ep21_s03_l01",
   "scene": 3,
   "speakerId": "NARRATOR",
   "speakerName": "الراوي",
   "direction": "بتأنن",
   "text": "الاجتهاد في أصله محاولة علمية لفهم الأحكام واستنباطها من أدلتها لكن الخلاف يبدأ حين يرى فريقاً أن نصاً صحيحاً صريحاً قد حسم مسألة بينما يرى فريق آخر أن النص يحتاج إلى تفسير أو تخصيص أو أن ثبوته أو دلالته موضع بحث",
   "startMs": 23580,
   "endMs": 43640,
   "clip": {
    "file": "audio/Batch 3/Narrŕatttor.wav",
    "startMs": 149430,
    "endMs": 169490
   },
   "lines": [
    {
     "text": "الاجتهاد في أصله محاولة علمية لفهم الأحكام واستنباطها من أدلتها لكن الخلاف يبدأ حين يرى فريقاً أن نصاً صحيحاً صريحاً قد حسم مسألة بينما يرى فريق آخر أن النص يحتاج إلى تفسير أو تخصيص أو أن ثبوته أو دلالته موضع بحث",
